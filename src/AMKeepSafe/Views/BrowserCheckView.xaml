<UserControl x:Class="AMKeepSafe.Views.BrowserCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AMKeepSafe.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BrowserCheckViewModel}">

    <UserControl.Resources>
        <ResourceDictionary Source="/AMKeepSafe;component/Theme/ResultCard.xaml" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,28" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Browser check" Style="{StaticResource HeadingText}" />
            <TextBlock Text="{Binding Text.Notes.Intro}" Style="{StaticResource BodyText}" Margin="0,10,0,0" />

            <Button Content="{Binding CheckButtonText}" Command="{Binding CheckCommand}" Style="{StaticResource PrimaryButton}"
                    FontSize="20" Padding="40,12" MinHeight="56" Margin="0,20,0,0" HorizontalAlignment="Left" />

            <TextBlock Text="{Binding Text.Notes.Checking}" Style="{StaticResource MutedText}" Margin="0,16,0,0"
                       AutomationProperties.LiveSetting="Polite"
                       Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />

            <!-- Shown when a different account's browsers were checked, or none were found. -->
            <Border Margin="0,20,0,0" Padding="16,12" CornerRadius="6" Background="{StaticResource StatusInfoBackgroundBrush}"
                    Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Note}" Style="{StaticResource BodyText}" />
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,24,0,8" Padding="22,18"
                    Visibility="{Binding HasHeadline, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Headline}" Style="{StaticResource SubheadingText}" AutomationProperties.LiveSetting="Polite" />
            </Border>

            <ItemsControl ItemsSource="{Binding Sections}" Focusable="False" AutomationProperties.Name="Browser check results">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BrowserSectionViewModel}">
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource SubheadingText}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Results}" ItemTemplate="{StaticResource ResultCard}" Focusable="False"
                                          AutomationProperties.Name="{Binding Label}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
