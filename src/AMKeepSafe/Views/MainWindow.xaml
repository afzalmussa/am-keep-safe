<Window x:Class="AMKeepSafe.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AMKeepSafe.ViewModels"
        xmlns:views="clr-namespace:AMKeepSafe.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="AM Keep Safe"
        Icon="pack://application:,,,/AMKeepSafe;component/Assets/am-icon-white-edge.ico"
        Style="{StaticResource AppWindowStyle}"
        Width="1040" Height="720" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Shared layout for tabs that aren't built yet. Replaced tab by tab in later phases. -->
        <Style x:Key="TabPage" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="32,28" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: logo, name, free/Pro status and licence button. The only place outside the Pro tab that mentions Pro. -->
        <Border Grid.Row="0" Background="{StaticResource DarkBrush}" Padding="24,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/AMKeepSafe;component/Assets/am-icon-on-dark.png"
                           Width="52" Height="52" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="AM Software logo" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProductName}" FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold" FontSize="24" Foreground="{StaticResource OnDarkTextBrush}" />
                        <TextBlock Text="Check how your PC is set up, and get help with scams" FontSize="15"
                                   Foreground="{StaticResource OnDarkMutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border BorderBrush="{StaticResource MintBrush}" BorderThickness="1" CornerRadius="16"
                            Padding="14,5" Margin="0,4,12,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LicenceStatusText}" Foreground="{StaticResource MintBrush}"
                                   FontWeight="SemiBold" FontSize="15" />
                    </Border>
                    <Button Content="Get Pro" Style="{StaticResource PrimaryButton}"
                            Command="{Binding GetProCommand}" Margin="0,4,10,4"
                            Visibility="{Binding CanGetPro, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Enter licence key" Style="{StaticResource HeaderButton}"
                            Command="{Binding EnterLicenceKeyCommand}" Margin="0,4,0,4" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Only shown when started with dry-run, so it's obvious nothing will really change -->
        <Border Grid.Row="1" Background="{StaticResource WarningBackgroundBrush}"
                BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="0,0,0,2" Padding="24,10"
                Visibility="{Binding IsDryRun, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold"
                       Text="Test mode is on. The app will show what it would do, but nothing on this PC will be changed." />
        </Border>

        <TabControl Grid.Row="2" Style="{StaticResource MainTabControl}" ItemContainerStyle="{StaticResource MainTabItem}"
                    SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="Safety check" AutomationProperties.Name="Safety check">
                <views:SafetyCheckView DataContext="{Binding SafetyCheck}" />
            </TabItem>

            <TabItem Header="Browser check" AutomationProperties.Name="Browser check">
                <views:BrowserCheckView DataContext="{Binding BrowserCheck}" />
            </TabItem>

            <TabItem Header="Scam help" AutomationProperties.Name="Scam help">
                <ScrollViewer Style="{StaticResource TabPage}">
                    <Border Style="{StaticResource Card}" MaxWidth="820" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Scam help" Style="{StaticResource HeadingText}" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,0"
                                       Text="Calm, step-by-step help if you've seen a scary pop-up, let a stranger connect to your computer, or had a suspicious text, email or call." />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0"
                                       Text="This part of the app is still being built." />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Pro" AutomationProperties.Name="Pro">
                <ScrollViewer Style="{StaticResource TabPage}">
                    <Border Style="{StaticResource Card}" MaxWidth="820" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="AM Keep Safe Pro" Style="{StaticResource HeadingText}" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,0"
                                       Text="Pro adds a weekly check, a history of your results, one button to apply every recommended fix, app updates and a printable report. Every safety feature stays free." />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0"
                                       Text="This part of the app is still being built." />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AM Software, " FontSize="15" VerticalAlignment="Center" />
                    <Button Content="amsoftware.uk" Style="{StaticResource LinkButton}" Command="{Binding OpenWebsiteCommand}"
                            Padding="0,6" />
                    <Button Content="Get help" Style="{StaticResource LinkButton}" Command="{Binding GetHelpCommand}"
                            Margin="16,0,0,0" />
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Undo changes" Style="{StaticResource LinkButton}" Command="{Binding OpenUndoCommand}" Margin="0,0,14,0" />
                    <Button Content="View log" Style="{StaticResource LinkButton}" Command="{Binding ViewLogCommand}" Margin="0,0,14,0" />
                    <Button Content="Report a problem" Style="{StaticResource LinkButton}" Command="{Binding ReportProblemCommand}" Margin="0,0,14,0" />
                    <Button Content="Check for updates" Style="{StaticResource LinkButton}" Command="{Binding CheckForUpdatesCommand}" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource MutedText}" FontSize="15" VerticalAlignment="Center" />
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
