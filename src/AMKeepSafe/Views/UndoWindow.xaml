<Window x:Class="AMKeepSafe.Views.UndoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AMKeepSafe.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:UndoViewModel}"
        Title="AM Keep Safe"
        Icon="pack://application:,,,/AMKeepSafe;component/Assets/am-icon-white-edge.ico"
        Style="{StaticResource AppWindowStyle}"
        Width="720" Height="560" MinWidth="480" MinHeight="360"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,24,28,8">
            <TextBlock Text="{Binding Text.UndoWindowTitle}" Style="{StaticResource SubheadingText}" />
            <TextBlock Text="{Binding Text.UndoWindowIntro}" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="28,8,28,16">
                <TextBlock Text="{Binding Text.UndoEmpty}" Style="{StaticResource MutedText}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Entries}" Focusable="False" AutomationProperties.Name="Changes made by AM Keep Safe">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:UndoEntryViewModel}">
                            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Content="{Binding UndoButtonText}" Command="{Binding UndoCommand}" Style="{StaticResource SecondaryButton}"
                                                Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="{Binding OpenSettingsButtonText}" Command="{Binding OpenSettingsCommand}" Style="{StaticResource SecondaryButton}"
                                                Visibility="{Binding CanOpenSettings, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding WhenText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="28,12">
            <Button Content="{Binding Text.CloseButton}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                    IsDefault="True" IsCancel="True" Click="Close_Click" />
        </Border>
    </Grid>
</Window>
