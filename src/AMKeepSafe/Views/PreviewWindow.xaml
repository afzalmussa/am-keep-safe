<Window x:Class="AMKeepSafe.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fixes="clr-namespace:AMKeepSafe.Core.Fixes;assembly=AMKeepSafe.Core"
        Title="AM Keep Safe"
        Icon="pack://application:,,,/AMKeepSafe;component/Assets/am-icon-white-edge.ico"
        Style="{StaticResource AppWindowStyle}"
        Width="640" SizeToContent="Height" MaxHeight="760"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!-- Trust rule 4: exactly what will change, before anything does. Cancel is the default button. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,20">
                <TextBlock x:Name="HeadingBlock" Style="{StaticResource SubheadingText}" />

                <Border x:Name="DryRunBanner" Margin="0,12,0,0" Padding="14,10" CornerRadius="6" Visibility="Collapsed"
                        Background="{StaticResource WarningBackgroundBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1">
                    <TextBlock x:Name="DryRunText" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                </Border>

                <TextBlock x:Name="IntroBlock" Style="{StaticResource BodyText}" Margin="0,12,0,0" />

                <ItemsControl x:Name="ItemsList" Margin="0,14,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type fixes:PreviewItem}">
                            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="14" Margin="0,8,0,0">
                                        <Run Text="{Binding DataContext.DetailsLabel, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding TechnicalDetail, Mode=OneWay}" FontFamily="Consolas" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding UndoNote}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="RestartBlock" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,4,0,0" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="28,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" IsDefault="True" IsCancel="True" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Click="Confirm_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
