<UserControl x:Class="AMKeepSafe.Views.SafetyCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AMKeepSafe.ViewModels"
             xmlns:checks="clr-namespace:AMKeepSafe.Core.Checks;assembly=AMKeepSafe.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SafetyCheckViewModel}">

    <UserControl.Resources>
        <!-- Each status has its own colour, icon shape, symbol and words, so colour is never the only clue. -->
        <Style x:Key="StatusStripe" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource StatusUnknownBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static checks:CheckStatus.Good}">
                    <Setter Property="Background" Value="{StaticResource StatusGoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static checks:CheckStatus.Attention}">
                    <Setter Property="Background" Value="{StaticResource StatusAttentionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static checks:CheckStatus.Problem}">
                    <Setter Property="Background" Value="{StaticResource StatusProblemBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static checks:CheckStatus.Info}">
                    <Setter Property="Background" Value="{StaticResource StatusInfoBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="Background" Value="{StaticResource StatusUnknownBackgroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static checks:CheckStatus.Good}">
                    <Setter Property="Background" Value="{StaticResource StatusGoodBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static checks:CheckStatus.Attention}">
                    <Setter Property="Background" Value="{StaticResource StatusAttentionBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static checks:CheckStatus.Problem}">
                    <Setter Property="Background" Value="{StaticResource StatusProblemBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static checks:CheckStatus.Info}">
                    <Setter Property="Background" Value="{StaticResource StatusInfoBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource StatusUnknownBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static checks:CheckStatus.Good}">
                    <Setter Property="Foreground" Value="{StaticResource StatusGoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static checks:CheckStatus.Attention}">
                    <Setter Property="Foreground" Value="{StaticResource StatusAttentionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static checks:CheckStatus.Problem}">
                    <Setter Property="Foreground" Value="{StaticResource StatusProblemBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static checks:CheckStatus.Info}">
                    <Setter Property="Foreground" Value="{StaticResource StatusInfoBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Circle for most, triangle for "worth a look". -->
        <Style x:Key="StatusShape" TargetType="Path">
            <Setter Property="Data" Value="M 1,14 A 13,13 0 1 1 27,14 A 13,13 0 1 1 1,14 Z" />
            <Setter Property="Fill" Value="{StaticResource StatusUnknownBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static checks:CheckStatus.Good}">
                    <Setter Property="Fill" Value="{StaticResource StatusGoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static checks:CheckStatus.Attention}">
                    <Setter Property="Fill" Value="{StaticResource StatusAttentionBrush}" />
                    <Setter Property="Data" Value="M 14,1 L 27.5,26.5 L 0.5,26.5 Z" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static checks:CheckStatus.Problem}">
                    <Setter Property="Fill" Value="{StaticResource StatusProblemBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static checks:CheckStatus.Info}">
                    <Setter Property="Fill" Value="{StaticResource StatusInfoBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusSymbol" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Text" Value="?" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static checks:CheckStatus.Good}">
                    <Setter Property="Text" Value="&#x2713;" />
                    <Setter Property="FontFamily" Value="Segoe UI Symbol" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static checks:CheckStatus.Attention}">
                    <Setter Property="Text" Value="&#x21;" />
                    <Setter Property="Margin" Value="0,5,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static checks:CheckStatus.Problem}">
                    <Setter Property="Text" Value="&#x21;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static checks:CheckStatus.Info}">
                    <Setter Property="Text" Value="i" />
                    <Setter Property="FontFamily" Value="Georgia" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,28" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Safety check" Style="{StaticResource HeadingText}" />
            <TextBlock Style="{StaticResource BodyText}" Margin="0,10,0,0"
                       Text="Check how your PC is set up. This only looks: nothing on your PC is changed. It takes about a minute." />

            <Button Content="{Binding CheckButtonText}" Command="{Binding CheckCommand}" Style="{StaticResource PrimaryButton}"
                    FontSize="20" Padding="40,12" MinHeight="56" Margin="0,20,0,0" HorizontalAlignment="Left" />

            <!-- Progress: a steady bar and plain words. Nothing flashes. -->
            <StackPanel Margin="0,20,0,0" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar Height="10" Maximum="{Binding ChecksTotal}" Value="{Binding ChecksDone}" MaxWidth="480" HorizontalAlignment="Stretch"
                             Foreground="{StaticResource StatusGoodBrush}" Background="{StaticResource SurfaceBrush}"
                             BorderBrush="{StaticResource BorderBrush}" AutomationProperties.Name="Safety check progress" />
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <!-- Headline. Never says the PC "is safe" (trust rule 3). -->
            <Border Style="{StaticResource Card}" Margin="0,24,0,16" Padding="22,18"
                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource SubheadingText}" AutomationProperties.LiveSetting="Polite" />
                    <Button Content="{Binding WhatWeCheckedLink}" Command="{Binding ShowWhatWeCheckedCommand}" Style="{StaticResource LinkButton}"
                            HorizontalAlignment="Left" Margin="-4,8,0,0" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Results}" Focusable="False" AutomationProperties.Name="Safety check results">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CheckResultViewModel}">
                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14"
                                AutomationProperties.Name="{Binding AccessibleName}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" CornerRadius="8,0,0,8" Style="{StaticResource StatusStripe}" />

                                <StackPanel Grid.Column="1" Margin="20,18,22,18">
                                    <DockPanel LastChildFill="True">
                                        <Grid DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,14,0" VerticalAlignment="Top">
                                            <Path Style="{StaticResource StatusShape}" />
                                            <TextBlock Style="{StaticResource StatusSymbol}" />
                                        </Grid>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource StatusPill}" VerticalAlignment="Top" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource StatusPillText}" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SubheadingText}" FontSize="19" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource BodyText}" Margin="42,10,0,0" />

                                    <ItemsControl ItemsSource="{Binding Items}" Margin="42,8,0,0" Focusable="False"
                                                  Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <BulletDecorator Margin="0,3,0,0">
                                                    <BulletDecorator.Bullet>
                                                        <Ellipse Width="7" Height="7" Fill="{StaticResource TextBrush}" Margin="0,0,10,0" />
                                                    </BulletDecorator.Bullet>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                                </BulletDecorator>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <WrapPanel Margin="42,14,0,0">
                                        <Button Content="{Binding StepsButtonText}" Command="{Binding ToggleStepsCommand}" Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,10,8" Visibility="{Binding HasSteps, Converter={StaticResource BoolToVisibility}}" />
                                        <ItemsControl ItemsSource="{Binding Actions}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ResultActionViewModel}">
                                                    <Button Content="{Binding Label}" Command="{Binding OpenCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>

                                    <Border Margin="42,6,0,0" Padding="18,14" CornerRadius="6" Background="{StaticResource LightBrush}"
                                            Visibility="{Binding StepsOpen, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:StepViewModel}">
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding NumberText}" Style="{StaticResource BodyText}" FontWeight="Bold" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource BodyText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
