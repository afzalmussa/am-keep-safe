{
  // Everything the fixes, the preview and undo say. Edit the wording here without touching code.
  //
  // Each fix lists the check outcomes it's offered for (forOutcomes, matching data/checks.json),
  // the button label, the preview heading (title), wording for each change it can make, and what
  // to say when it's done or didn't work. Fixes are always free (trust rules 2 and 10).
  //
  // A change's undoText is only needed when the change can be undone inside the app. Changes that
  // switch a protection on are never switched off by the app (trust rule 6).

  "common": {
    "previewIntro": "Here's exactly what will change. Nothing happens until you click \"Make the change\".",
    "dryRunIntro": "Test mode is on, so nothing will actually change. AM Keep Safe will write down in the log what it would have done.",
    "confirmButton": "Make the change",
    "dryRunConfirmButton": "Show what would happen",
    "cancelButton": "Cancel",
    "detailsLabel": "Exactly what changes",
    "undoInApp": "You can undo this later from \"Undo changes\" at the bottom of the window.",
    "undoViaSettings": "This switches a protection on, so AM Keep Safe will never switch it off again for you. If you ever need to, you can change it yourself in Windows Settings.",
    "undoNotNeeded": "This doesn't change any settings, so there's nothing to undo.",
    "restartNeeded": "Windows needs a restart to finish this. You can restart whenever it suits you.",
    "nothingToDo": "This already looks fine now, so there's nothing to change.",
    "dryRunDone": "Test mode is on, so nothing was changed. What would have happened is written in the log.",
    "undoTitle": "Undo a change",
    "undoIntro": "This puts the setting back to how it was before AM Keep Safe changed it. Nothing happens until you click \"Undo the change\".",
    "undoConfirmButton": "Undo the change",
    "undoDone": "Done. The setting is back to how it was.",
    "undoFailed": "Windows didn't allow the setting to be changed back. Nothing else was affected, and the details are in the log.",
    "changedSinceNote": "This setting has been changed since AM Keep Safe changed it. Undoing will still put it back to how it was before.",

    "doneTitle": "Done",
    "partlyDoneTitle": "Partly done",
    "partlyDoneText": "Some of this was done, but Windows didn't allow all of it. The details are in the log.",
    "failedTitle": "That didn't go through",
    "dryRunTitle": "Test mode",
    "nothingToDoTitle": "Nothing to change",
    "workingText": "Working on it. You can keep using your PC.",

    "undoWindowTitle": "Undo changes",
    "undoWindowIntro": "Everything AM Keep Safe has changed on this PC, newest first.",
    "undoEmpty": "AM Keep Safe hasn't changed anything on this PC yet.",
    "undoneOn": "Undone on {date}",
    "undoButton": "Undo",
    "viaSettingsNote": "This switched a protection on, so AM Keep Safe won't switch it off. You can change it yourself in Windows Settings.",
    "openSettingsButton": "Open Windows Settings",
    "closeButton": "Close"
  },

