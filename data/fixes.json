      "buttonLabel": "Fix this",
      "title": "Turn the firewall back on",
      "changes": {
        "domain": { "text": "Turn the firewall on for work networks" },
        "private": { "text": "Turn the firewall on for home networks" },
        "public": { "text": "Turn the firewall on for public networks, like in cafés" }
      },
      "doneText": "The firewall is on again.",
      "failedText": "Windows didn't allow the firewall to be turned on. If another security app looks after your firewall, open that app instead. The details are in the log."
    },
