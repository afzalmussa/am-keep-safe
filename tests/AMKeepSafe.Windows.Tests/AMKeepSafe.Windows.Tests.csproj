<Project Sdk="Microsoft.NET.Sdk">

  <!-- Integration tests that read real Windows settings through real PowerShell and the registry.
       Windows only, run by CI on the Windows runner. Nothing here changes a setting the PC uses:
       the remove-and-restore tests work on a scratch key under HKCU\Software\AMKeepSafe.Tests and a
       temporary folder, and delete both when they finish. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="GitHubActionsTestLogger" Version="3.0.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AMKeepSafe.Windows\AMKeepSafe.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
